# Navigation and basics
alias q='exit'
alias c='clear'
alias cls='clear; ls'
alias lg='lazygit'
alias hx='helix'
alias e='helix "$(find | fzf --preview "cat {}")"'

# Notifications
alias alert='notify-send --urgency=low \
    -i "$([ $? = 0 ] && echo terminal || echo error)" \
    "$(history | tail -n1 | sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

